#!/usr/bin/env bash
# configuring a loadbalancer

sudo apt-get update
sudo apt-get install -y haproxy

cat << "EOF" > /etc/haproxy/haproxy.cfg
  frontend myfrontend
    mode http
    bind *:80
    default_backend web-servers

  backend web-servers
    balance roundrobin
    server web-01 18.170.79.166 check
    server web-02 3.8.124.233 check
EOF
service haproxy restart
