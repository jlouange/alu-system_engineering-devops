#!/usr/bin/env bash
# run Nginx as nginx user on port 8080
id nginx &>/dev/null || useradd -r -s /usr/sbin/nologin nginx
pkill -x nginx 2>/dev/null || true
sed -i 's/^user www-data;/# user www-data;/; s|pid /run/nginx.pid;|pid /run/nginx/nginx.pid;|' /etc/nginx/nginx.conf
sed -i 's/listen 80 /listen 8080 /; s/:80 /:8080 /' /etc/nginx/sites-available/default
mkdir -p /run/nginx
chown -R nginx:nginx /run/nginx /var/log/nginx /var/lib/nginx
su -s /bin/sh nginx -c '/usr/sbin/nginx'
