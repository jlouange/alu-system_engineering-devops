#!/usr/bin/env bash
# Run Nginx as nginx on port 8080.

set -e

pkill -x nginx 2>/dev/null || true

id nginx >/dev/null 2>&1 || useradd -r -s /usr/sbin/nologin nginx

sed -i 's/^user /#user /; s|^pid .*;|pid /tmp/nginx.pid;|' /etc/nginx/nginx.conf

sed -i 's/listen 80 /listen 8080 /; s/\[::\]:80 /[::]:8080 /' /etc/nginx/sites-enabled/default

chown -R nginx:nginx /var/log/nginx /var/lib/nginx

su -s /bin/sh nginx -c '/usr/sbin/nginx'
